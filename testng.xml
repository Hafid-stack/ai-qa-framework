<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AI-QA-Framework Suite">
    <listeners>
        <listener class-name="utils.ExtentTestListener"/>
    </listeners>
    <!-- Offline tests for the generation pipeline itself: no browser, no network, no live
         site, so a failure here is always a defect in this project rather than an outage
         somewhere else. Listed first because it is the fastest signal in the suite. -->
    <test name="Pipeline Unit Tests">
        <classes>
            <class name="parser.HtmlParserTest"/>
            <class name="parser.SelectorPriorityFinderTest"/>
            <class name="generator.PageObjectGeneratorTest"/>
        </classes>
    </test>
    <test name="UI Tests">
        <classes>
            <class name="ui.logintests.noflow.LoginTest"/>
            <class name="ui.logintests.noflow.InvalidLoginTest"/>
            <class name="ui.logintests.LoginUsingValidCredentialsTest"/>
            <class name="ui.logintests.LoginUsingInvalidCredentialsTest"/>
            <class name="ui.logintests.LoginUsingLockedUserTest"/>
            <class name="ui.logouttests.LogoutCorrectlyTest"/>
            <class name="ui.shoppingtests.AddingItemsToCartTest"/>
            <class name="ui.shoppingtests.FillingCustomerInfoTest"/>
            <class name="ui.e2e.CompleteCheckOutE2ETest"/>
        </classes>
    </test>
    <test name="API Tests">
        <classes>
            <class name="api.PingTest"/>
            <class name="api.BookingTest"/>
        </classes>
    </test>
    <test name="Generated Page Objects Demo">
        <classes>
            <class name="ui.generated.AutomationExerciseGeneratedFlowTest"/>
            <class name="ui.generated.SauceDemoGeneratedLoginTest"/>
        </classes>
    </test>
</suite>